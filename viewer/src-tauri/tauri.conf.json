{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parley Conversation Viewer",
  "version": "0.1.0",
  "identifier": "com.ickleslimer.parley-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "detail",
        "title": "Parley Conversation Viewer",
        "url": "index.html?view=detail",
        "width": 1120,
        "height": 760,
        "minWidth": 840,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "alwaysOnTop": false,
        "visible": false,
        "backgroundColor": "#2c2428"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ickleslimer",
    "shortDescription": "Exact local Parley conversation viewer",
    "longDescription": "A local Windows desktop-underlay widget and transcript browser for Parley JSONL event logs.",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../health/target/release/parley-health-supervisor.exe": "health/parley-health-supervisor.exe",
      "../../health/target/release/parley-health-query.exe": "health/parley-health-query.exe",
      "../../health/target/release/parley-health-hook.exe": "health/parley-health-hook.exe",
      "../../handoff/target/release/parley-peer-peek.exe": "handoff/parley-peer-peek.exe",
      "../../handoff/target/release/parley-handoff-wait.exe": "handoff/parley-handoff-wait.exe",
      "../../handoff/target/release/parley-peer-alert.exe": "handoff/parley-peer-alert.exe",
      "../../handoff/target/release/parley-handoff-hook.exe": "handoff/parley-handoff-hook.exe",
      "../../lanes/target/release/parley-lane-hook.exe": "lanes/parley-lane-hook.exe",
      "../../health/assets/two-chairs.wav": "health/two-chairs.wav"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Parley",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
